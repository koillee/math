{
  "name": "nextjs-shadcn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "prisma generate && BUILD_DIR=.next-build next build",
    "build:local": "BUILD_DIR=.next-build next build",
    "lint": "biome lint . && tsc --noEmit --incremental false",
    "test:item-bank": "tsx scripts/validate-item-bank.ts",
    "test:practice-quality": "tsx scripts/validate-practice-quality.ts",
    "test:production-safety": "tsx scripts/validate-production-safety.ts",
    "test:safe": "npm run test:production-safety && npm run test:item-bank && npm run test:practice-quality",
    "test:mvp": "node scripts/mvp-smoke.mjs",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^20.17.50",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.1.7",
    "postcss": "^8.5.3",
    "prisma": "6.19.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3"
  }
}
